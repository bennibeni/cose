ARCHIVE_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
STORAGE_BACKEND=local
APP_ORIGIN=http://localhost:3000
# Persistent directory, shared by data and protected photos
DATA_DIR=./data
# Enable behind an HTTPS reverse proxy in production
COOKIE_SECURE=false
# Vercel: STORAGE_BACKEND=drive, APP_ORIGIN=https://your-app.vercel.app
# Server-only secrets. Obtain these with scripts/connect-drive.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ARCHIVE_ID=
ARCHIVE_ENCRYPTION_KEY=
